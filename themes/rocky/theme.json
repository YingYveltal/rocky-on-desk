{
  "schemaVersion": 1,
  "name": "Rocky",
  "author": "yingyaogu",
  "version": "0.1.0",
  "description": "Rocky the Eridian engineer from Project Hail Mary — a pixel art desktop pet",

  "viewBox": {
    "x": -15,
    "y": -25,
    "width": 45,
    "height": 45
  },

  "layout": {
    "contentBox": { "x": -6, "y": -5, "width": 27, "height": 22 },
    "centerX": 7.5,
    "baselineY": 17,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },

  "eyeTracking": {
    "enabled": true,
    "states": ["idle"],
    "eyeRatioX": 0.49,
    "eyeRatioY": 0.72,
    "maxOffset": 3,
    "bodyScale": 0.33,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "7.5px 15px"
  },

  "sleepSequence": {
    "mode": "direct"
  },

  "states": {
    "idle":         ["rocky-idle.svg"],
    "thinking":     ["rocky-thinking.svg"],
    "working":      ["rocky-working.svg"],
    "error":        { "fallbackTo": "attention" },
    "attention":    ["rocky-happy.svg"],
    "notification": { "fallbackTo": "attention" },
    "sleeping":     ["rocky-sleeping.svg"]
  },

  "timings": {
    "minDisplay": {
      "attention": 4000,
      "error": 5000,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000,
      "error": 5000
    },
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },

  "hitBoxes": {
    "default": { "x": -2, "y": 3, "width": 19, "height": 14 },
    "sleeping": { "x": -2, "y": 9, "width": 19, "height": 7 }
  },

  "sleepingHitboxFiles": ["rocky-sleeping.svg"],

  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
