{
  "schemaVersion": 1,
  "name": "Rocky (Domed)",
  "author": "yingyaogu",
  "version": "2.0.0",
  "description": "Rocky 罩装版 — 装在正十二面体 xenonite 大气舱里的硅基外星伙伴，致敬《挽救计划》原著。10 个状态附带罩子动效（摇晃/抖动/弹跳）。",
  "viewBox": {
    "x": -15,
    "y": -25,
    "width": 45,
    "height": 45
  },
  "layout": {
    "contentBox": { "x": -2, "y": -3, "width": 19, "height": 20 },
    "marginBox":  { "x": -6, "y": -7, "width": 27, "height": 24 },
    "centerX": 7.5,
    "baselineY": 17,
    "visibleHeightRatio": 0.62,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": ["idle", "dozing"],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.7,
    "maxOffset": 2,
    "bodyScale": 0.25,
    "shadowStretch": 0.12,
    "shadowShift": 0.25,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js",
      "dozeEyes": "eyes-doze"
    },
    "shadowOrigin": "7.5px 15px"
  },
  "states": {
    "idle":         ["rocky-idle-follow.svg"],
    "yawning":      ["rocky-idle-yawn.svg"],
    "dozing":       ["rocky-idle-doze.svg"],
    "collapsing":   ["rocky-collapse-sleep.svg"],
    "sleeping":     ["rocky-sleeping.svg"],
    "waking":       ["rocky-wake.svg"],
    "thinking":     ["rocky-working-thinking.svg"],
    "working":      ["rocky-working-typing.svg"],
    "juggling":     ["rocky-working-juggling.svg"],
    "sweeping":     ["rocky-working-sweeping.svg"],
    "carrying":     ["rocky-working-carrying.svg"],
    "error":        ["rocky-error.svg"],
    "attention":    ["rocky-happy.svg"],
    "notification": ["rocky-notification.svg"]
  },
  "workingTiers": [
    { "minSessions": 3, "file": "rocky-working-building.svg" },
    { "minSessions": 2, "file": "rocky-working-juggling.svg" },
    { "minSessions": 1, "file": "rocky-working-typing.svg" }
  ],
  "idleAnimations": [
    { "file": "rocky-idle-look.svg", "duration": 7000 }
  ],
  "displayHintMap": {
    "rocky-working-building.svg": "rocky-working-building.svg",
    "rocky-working-typing.svg":   "rocky-working-typing.svg",
    "rocky-working-juggling.svg": "rocky-working-juggling.svg",
    "rocky-working-thinking.svg": "rocky-working-thinking.svg"
  },
  "timings": {
    "minDisplay": {
      "attention": 4000,
      "error": 5000,
      "sweeping": 5000,
      "notification": 2500,
      "carrying": 3000,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4000,
      "error": 5000,
      "sweeping": 300000,
      "notification": 2500,
      "carrying": 3000
    },
    "yawnDuration": 3000,
    "wakeDuration": 1500,
    "deepSleepTimeout": 600000,
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },
  "hitBoxes": {
    "default":  { "x": -2, "y": -3, "w": 19, "h": 20 },
    "sleeping": { "x": -2, "y":  9, "w": 19, "h":  7 },
    "wide":     { "x": -4, "y": -5, "w": 23, "h": 22 }
  },
  "wideHitboxFiles": [
    "rocky-error.svg",
    "rocky-notification.svg",
    "rocky-working-building.svg"
  ],
  "sleepingHitboxFiles": [
    "rocky-sleeping.svg",
    "rocky-collapse-sleep.svg"
  ],
  "reactions": {
    "drag":       { "file": "rocky-react-drag.svg" },
    "double":     { "files": ["rocky-react-double.svg"], "duration": 3500 }
  },
  "miniMode": {
    "supported": false
  },
  "objectScale": {
    "widthRatio": 1.9,
    "heightRatio": 1.3,
    "offsetX": -0.45,
    "offsetY": -0.25
  }
}
